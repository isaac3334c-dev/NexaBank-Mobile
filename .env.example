# Copiar a .env.local y completar. .env.local nunca se commitea (ver .gitignore).

# nexabank-api corriendo en local. Como Expo Go corre en un dispositivo físico,
# NO usar localhost: debe ser la IP LAN de esta máquina (ver `ip -4 addr`). Esta IP
# puede cambiar entre reinicios/reconexiones de red (DHCP) — si Expo Go no conecta,
# verificar primero que esta IP sigue siendo la actual.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.19:8080/api/v1

# Config del Web App de Firebase del proyecto nexabank-core (Project settings > General > Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nexabank-core.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nexabank-core
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nexabank-core.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=818604589223
EXPO_PUBLIC_FIREBASE_APP_ID=1:818604589223:web:ebbe8938a98b1aacfe9b82
